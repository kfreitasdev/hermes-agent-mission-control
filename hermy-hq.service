[Unit]
Description=Glowryia Hermy HQ Mission Control
After=network-online.target hermes-bridge.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/tools_hub/hermes-agent-mission-control
EnvironmentFile=/root/tools_hub/hermes-agent-mission-control/.env
Environment=HOME=/root
Environment=PORT=3002
Environment=HOSTNAME=127.0.0.1
ExecStart=/root/.hermes/tools/node-26.7.0-linux-x64/bin/node /root/tools_hub/hermes-agent-mission-control/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3002
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
