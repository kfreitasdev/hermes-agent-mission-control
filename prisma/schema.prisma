generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "agent_mission"]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])

  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  @@schema("public")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])

  @@schema("public")
}

model Draft {
  id              String    @id @default(uuid())
  text            String
  title           String?
  model           String?
  status          String    @default("pending")
  type            String?
  category        String?
  hookType        String?
  feedbackRating  String?
  feedbackReason  String?
  viralScore      Json?
  impressionScore Json?
  scheduledDate   String?
  scheduledTime   String?
  visualUrl       String?
  variantGroup    String?
  postedAt        DateTime?
  postedUrl       String?
  tweetUrl        String?
  tweetId         String?
  metrics         Json?
  editHistory     Json?     @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  quoteUrl        String?
  quoteText       String?

  // Content intelligence fields
  source          String?   // "sage" | "organic" | "csv_import"
  engagementScore Float?    // time-weighted composite score (updated by scoring engine)
  engagementTier  String?   // "top20" | "bottom20" | null (cleared/set on rescore)

  @@index([status])
  @@index([createdAt])
  @@index([tweetId])
  @@index([source])
  @@index([engagementTier])

  @@schema("agent_mission")
}

model TweetMetric {
  id          String    @id @default(cuid())
  draftId     String
  tweetId     String?
  url         String?
  postedAt    DateTime?
  checkpoints Json?
  createdAt   DateTime  @default(now())

  @@index([draftId])

  @@schema("agent_mission")
}

model Idea {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String?
  type        String?
  model       String?
  status      String?
  timestamp   DateTime @default(now())

  @@index([category])
  @@index([type])

  @@schema("agent_mission")
}

model ContentCalendar {
  id   String @id @default(cuid())
  week String @unique
  data Json

  @@schema("agent_mission")
}

model YoutubeIdea {
  id                String   @id @default(cuid())
  title             String
  hook              String?
  angle             String?
  hookType          String?
  funnelStage       String?
  status            String   @default("pending")
  rejectedReason    String?
  sourceUrl         String?
  sourceSummary     String?
  competitionScore  String?  // "gap" | "moderate" | "crowded"
  competitionData   Json?    // { resultCount, avgViews, topVideos[], scoredAt }
  createdAt         DateTime @default(now())

  @@index([status])

  @@schema("agent_mission")
}

model YoutubeScript {
  id              String   @id @default(cuid())
  title           String
  hook            String?
  storySetup      String?
  conflict        String?
  insight         String?
  cta             String?
  caption         String?
  onScreenText    String?
  hookType        String?
  funnelStage     String?
  factCheck       Json?
  fullScript      String?
  status          String   @default("draft")
  rejectedReason  String?
  // SEO Package
  seoTitle        String?
  seoDescription  String?
  seoTags         Json?
  seoChapters     Json?
  titleVariants   Json?
  thumbnailConcept String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])

  @@schema("agent_mission")
}

model YoutubeFeedback {
  id     String   @id @default(cuid())
  title  String
  reason String?
  type   String?
  date   DateTime @default(now())

  @@schema("agent_mission")
}

model LongformScript {
  id               String   @id @default(cuid())
  title            String
  type             String?
  status           String   @default("draft")
  platform         String?
  platforms        Json?
  description      String?
  hook             String?
  outline          String?
  fullScript       String?
  targetLength     String?
  factCheck        Json?
  notes            String?
  rejectedReason   String?
  youtubeUrl       String?
  thumbnailUrl     String?
  tweetUrl         String?
  youtubeViews     Int?
  youtubeLikes     Int?
  youtubeComments  Int?
  tweetViews       Int?
  tweetLikes       Int?
  tweetBookmarks   Int?
  tweetRetweets    Int?
  tweetReplies     Int?
  postedAt         DateTime?
  competitionScore String?  // "gap" | "moderate" | "crowded"
  competitionData  Json?    // { resultCount, avgViews, topVideos[], scoredAt }
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])

  @@schema("agent_mission")
}

model AgentState {
  id             String    @id
  name           String
  emoji          String?
  role           String?
  status         String    @default("offline")
  lastActive     DateTime?
  tasksCompleted Int       @default(0)
  totalCost      Float     @default(0)
  currentTask    String?
  recentActivity Json?     @default("[]")
  updatedAt      DateTime  @updatedAt

  @@schema("agent_mission")
}

model AgentBusMessage {
  id        String   @id @default(uuid())
  fromAgent String
  toAgent   String
  type      String
  content   String
  metadata  Json?
  read      Boolean  @default(false)
  timestamp DateTime @default(now())

  @@index([toAgent, read])
  @@index([fromAgent])

  @@schema("agent_mission")
}

model BattleRoyaleBot {
  id        String   @id
  state     Json
  updatedAt DateTime @updatedAt

  @@schema("agent_mission")
}

model ContentRequest {
  id             String    @id @default(uuid())
  prompt         String
  status         String    @default("pending")
  resultDraftIds Json?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@schema("agent_mission")
}

// ─── Generic Key-Value Store ────────────────────────────────────

model DataStore {
  key       String   @id
  data      Json
  updatedAt DateTime @map("updated_at") @updatedAt

  @@map("data_store")
  @@schema("agent_mission")
}

// ─── Daily Briefs ───────────────────────────────────────────────

model Brief {
  id        String   @id @default(uuid()) @db.Uuid
  date      String   @unique @map("date_key")
  content   String   @db.Text
  source    String   @default("brief")
  createdAt DateTime @map("created_at") @default(now())

  @@map("briefs")
  @@schema("agent_mission")
}

// ─── Missions ───────────────────────────────────────────────────

model Mission {
  id          String   @id @default(uuid()) @db.Uuid
  agentId     String   @map("agent_id")
  title       String
  description String   @db.Text
  status      String   @default("Not started")
  priority    String   @default("Medium")
  result      String?  @db.Text
  companyId   String?  @map("company_id") @db.Uuid
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @map("created_at") @default(now())
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime @map("updated_at") @updatedAt

  @@index([agentId])
  @@index([status])
  @@map("missions")
  @@schema("agent_mission")
}

// ─── Articles ───────────────────────────────────────────────────

model Article {
  id              String    @id @default(uuid())
  title           String
  body            String    @db.Text
  track           String    // "mega-viral" | "local-viral" | "icp-viral"
  status          String    @default("idea") // "idea" | "draft" | "ready" | "posted"
  qtTweet         String?   @db.Text
  qtUrl           String?
  heroImageUrl    String?
  heroImageHtml   String?   @db.Text
  inspirationUrls String?   @db.Text // JSON array of URLs
  themes          String?   // JSON array of themes
  scheduledDate   String?
  postedAt        DateTime?
  postedUrl       String?
  impressions     Int?
  likes           Int?
  bookmarks       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([track])
  @@index([scheduledDate])

  @@schema("agent_mission")
}

model SavedTitle {
  id        String   @id @default(cuid())
  title     String
  track     String
  themes    String?  // JSON array
  createdAt DateTime @default(now())

  @@index([track])

  @@schema("agent_mission")
}

// ─── Client Pulse Telegram Bot ─────────────────────────────────

model ClientPulseClient {
  id                   String                @id @default(cuid())
  clientName           String
  status               String?
  services             Json                  @default("[]")
  productManagerName   String?
  renewalDate          DateTime?
  endDate              DateTime?
  expectedCheckinHours Int                   @default(72)
  sourceUpdatedAt      DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  chats                ClientPulseChat[]
  analyses             ClientPulseAnalysis[]
  alerts               ClientPulseAlert[]

  @@index([status])
  @@index([clientName])
  @@index([productManagerName])

  @@schema("agent_mission")
}

model ClientPulseChat {
  id              String               @id @default(cuid())
  telegramChatId  String               @unique
  title           String
  linkedClientId  String?
  status          String               @default("active")
  internalUserIds Json                 @default("[]")
  lastSeenAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  linkedClient    ClientPulseClient?   @relation(fields: [linkedClientId], references: [id], onDelete: SetNull)
  messages        ClientPulseMessage[]
  alerts          ClientPulseAlert[]

  @@index([linkedClientId])
  @@index([status])

  @@schema("agent_mission")
}

model ClientPulseMessage {
  id                String           @id @default(cuid())
  telegramMessageId String
  telegramChatId    String
  chatId            String?
  senderTelegramId  String
  senderName        String
  isInternal        Boolean          @default(false)
  isBot             Boolean          @default(false)
  text              String           @db.Text
  sentAt            DateTime
  intent            String           @default("other")
  sentiment         String           @default("neutral")
  needsReply        Boolean          @default(false)
  rawJson           Json?
  createdAt         DateTime         @default(now())
  chat              ClientPulseChat? @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@unique([telegramChatId, telegramMessageId])
  @@index([telegramChatId, sentAt])
  @@index([chatId, sentAt])
  @@index([needsReply])

  @@schema("agent_mission")
}

model ClientPulseAnalysis {
  id                  String            @id @default(cuid())
  clientId            String
  windowStart         DateTime
  windowEnd           DateTime
  sentimentScore      Int
  responseScore       Int
  cadenceScore        Int
  renewalRiskScore    Int
  positiveSignalScore Int               @default(70)
  overallScore        Int
  category            String
  reasons             Json              @default("[]")
  evidence            Json              @default("[]")
  recommendedAction   String?           @db.Text
  llmSummary          String?           @db.Text
  analysisSource      String            @default("fallback")
  analyzedAt          DateTime          @default(now())
  client              ClientPulseClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, analyzedAt])
  @@index([category])
  @@index([overallScore])

  @@schema("agent_mission")
}

model ClientPulseAlert {
  id                String             @id @default(cuid())
  clientId          String?
  chatId            String?
  type              String
  severity          String
  evidence          Json               @default("[]")
  reason            String             @db.Text
  recommendedAction String?            @db.Text
  sentTo            String?
  sentAt            DateTime?
  acknowledgedAt    DateTime?
  createdAt         DateTime           @default(now())
  client            ClientPulseClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  chat              ClientPulseChat?   @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([severity])
  @@index([sentAt])
  @@index([acknowledgedAt])

  @@schema("agent_mission")
}

// ─── Hermes bus (Hermy HQ website ↔ Hermes on the Mac mini) ─────
// Shared Postgres is the message bus. A bridge on the mini polls
// AgentRequest, runs approved/safe ones via the `hermes` CLI, and
// mirrors kanban tasks + activity back into HermesTask / AgentEvent.

model AgentRequest {
  id            String    @id @default(uuid()) @db.Uuid
  origin        String    @default("web")     // "web" | "hermes"
  kind          String    @default("oneshot") // "oneshot" | "kanban" | "chat"
  title         String
  prompt        String?
  targetProfile String    @map("target_profile") @default("glowryia")
  handoff       Json      @default("{}")
  sideEffecting Boolean   @map("side_effecting") @default(false)
  status        String    @default("queued")  // queued | awaiting_approval | approved | running | done | failed | rejected
  result        String?
  error         String?
  hermesTaskId  String?   @map("hermes_task_id")
  metadata      Json      @default("{}")
  companyId     String?   @map("company_id") @db.Uuid
  clientId      String?   @map("client_id") @db.Uuid
  projectId     String?   @map("project_id") @db.Uuid
  decidedAt     DateTime? @map("decided_at")
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  createdAt     DateTime  @map("created_at") @default(now())
  updatedAt     DateTime  @map("updated_at") @updatedAt
  revision      Int       @default(0)
  idempotencyKey String?  @map("idempotency_key")

  @@index([status])
  @@index([createdAt])
  @@map("requests")
  @@schema("agent_mission")
}

model AgentEvent {
  id        String   @id @default(uuid()) @db.Uuid
  requestId String?  @map("request_id") @db.Uuid
  kind      String   @default("activity") // activity | run | status | memory
  title     String
  detail    String?
  agent     String?
  level     String   @default("info")     // info | up | warn | down
  meta      Json?
  createdAt DateTime @map("created_at") @default(now())

  @@index([createdAt])
  @@map("events")
  @@schema("agent_mission")
}

model HermesTask {
  id        String   @id                   // Hermes task id
  board     String   @default("default")
  title     String
  assignee  String?
  status    String   @default("todo")
  priority  Int?
  result    String?
  updatedAt DateTime @map("updated_at") @default(now())
  syncedAt  DateTime @map("synced_at") @updatedAt

  @@index([board])
  @@index([status])
  @@map("hermes_tasks")
  @@schema("agent_mission")
}

// ─── Hermes Memory Wiki (warm tier — git-tracked markdown, mirrored) ─────
model HermesMemory {
  id         String    @id            // wiki entry slug (relative path w/o .md)
  path       String                   // file path relative to wiki root
  type       String    @default("fact")
  title      String
  status     String    @default("active")
  confidence String?
  provenance String?
  tags       String[]
  links      String[]
  body       String    @default("")
  validFrom  DateTime? @map("valid_from")
  validTo    DateTime? @map("valid_to")
  updatedAt  DateTime  @map("updated_at") @default(now())
  syncedAt   DateTime  @map("synced_at") @updatedAt

  @@index([type])
  @@index([status])
  @@map("memory_entries")
  @@schema("agent_mission")
}
